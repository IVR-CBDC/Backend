# Existing production connections only. Never use local development values here.
SHARED_DIR=/home/deploy/ivr-cbdc/shared
# Set to `id -u deploy` / `id -g deploy` on the VPS.
DEPLOY_UID=1000
DEPLOY_GID=1000
# An EXISTING Docker network that can reach the existing PostgreSQL and Redis.
APP_NETWORK=ivrcbdc-prod_private
AUTH_DB_HOST=pg-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
CORE_DB_HOST=pg-core
CORE_DB_PORT=5432
CORE_DB_NAME=core
CORE_DB_USER=core
COMMISSION_DB_HOST=pg-commission
COMMISSION_DB_PORT=5432
COMMISSION_DB_NAME=commission
COMMISSION_DB_USER=commission
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
# Existing passwords/JWT keys stay in shared/secrets, never in Git or release bundles.
